{
  "name": "pm-detect",
  "version": "0.5.0",
  "description": "A CLI tool to detect the node package manager used in a project",
  "author": "Jack Westbrook <jack.westbrook@gmail.com>",
  "bin": {
    "pm-detect": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "test": "vitest",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "package-manager",
    "package",
    "manager",
    "node",
    "detect",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "bugs": "https://github.com/jackw/pm-detect/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackw/pm-detect.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/recommended": "^1.0.10",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
